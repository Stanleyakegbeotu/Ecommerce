# Browser-safe values only. Never put service-role, SMTP, database, or other
# privileged credentials in a VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase Edge Function secrets (set in Supabase only; never place in this file
# with values, never prefix them with VITE_, and never set them in Netlify).
# SMTP_HOST=
# SMTP_PORT=
# SMTP_SECURE=
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=
# SMTP_FROM_NAME=
# ADMIN_NOTIFICATION_EMAIL=
# Legacy aliases supported during secret rotation: SMTP_FROM, NOTIFICATION_RECIPIENT
# DIGEST_SCHEDULER_SECRET=
# META_CAPI_ACCESS_TOKEN=
# META_GRAPH_API_VERSION=
# META_PROCESSOR_SECRET=
